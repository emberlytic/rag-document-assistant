# LLM Backend: "claude" or "ollama"
LLM_BACKEND=claude

# Claude API (used when LLM_BACKEND=claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (optional — adds GPT-4o-mini as a provider option)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional — adds Gemini Flash as a provider option)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Ollama (optional — adds local fully-private model; no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:27b

# ChromaDB storage path
CHROMA_DB_PATH=./db/chroma

# SQLite registry path
REGISTRY_DB_PATH=./db/registry.db

# Secrets backend: "env" (reads the variables above from the environment) or
# "cloud" (stub -- raises NotImplementedError, see core/secrets.py)
SECRETS_PROVIDER=env
